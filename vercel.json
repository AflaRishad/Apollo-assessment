{
  "version": 3,
  "projectSettings": {
    "framework": "vite"
  },
  "builds": [
    {
      "src": "apollo/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "apollo/frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
